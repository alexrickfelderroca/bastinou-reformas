# Bastinou — variables de entorno para el endpoint de leads (/api/lead, §6).
# Copia este archivo a .env y rellena los valores. [PENDIENTE: credenciales reales]
# Sin estas variables, el lead se registra en el log del servidor y el formulario
# responde OK (útil en desarrollo), pero NO se envía email/Telegram.

# --- Email (Resend: https://resend.com) ---
RESEND_API_KEY=
LEAD_TO_EMAIL=info@bastinou.com
LEAD_FROM_EMAIL=Bastinou <leads@bastinou.com>

# --- Telegram (opcional) ---
# Crea un bot con @BotFather y obtén el chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
