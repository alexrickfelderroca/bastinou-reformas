# Kobor — variables de entorno para el endpoint de leads (/api/lead, §6).
# Copia este archivo a .env y rellena los valores. [PENDIENTE: credenciales reales]
# Sin estas variables, el lead se registra en el log del servidor y el formulario
# responde OK (útil en desarrollo), pero NO se envía email/Telegram.

# --- Email: destino y remitente (comunes a las dos vías) ---
LEAD_TO_EMAIL=admin@kobor.es
# Opcional. Con SMTP, si se define debe ser el propio buzón autenticado.
LEAD_FROM_EMAIL=

# --- Email, vía A (RECOMENDADA): SMTP del buzón de Hostinger ---
# Usa el buzón admin@kobor.es creado en hPanel -> Correo. No requiere ninguna
# cuenta externa. Puerto 465 = TLS implícito (587 también vale: STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@kobor.es
SMTP_PASS=

# --- Email, vía B: Resend (https://resend.com) ---
# Alternativa por API REST. Requiere cuenta y verificar el dominio kobor.es
# (registros DNS). Si las dos vías están configuradas, Resend tiene prioridad
# y SMTP queda de respaldo.
RESEND_API_KEY=

# --- Telegram (opcional) ---
# Crea un bot con @BotFather y obtén el chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Tag Manager (Fase 7 — tracking) ---
# ID del contenedor GTM. Público (aparece en el HTML), por eso lleva prefijo
# PUBLIC_. Sin un ID real (GTM-XXXXXXX) el tracking queda dormido: no se carga
# GTM ni se muestra el banner de cookies. GA4 y las conversiones de Google Ads
# se configuran DENTRO del contenedor de GTM, no en el código. [PENDIENTE].
PUBLIC_GTM_ID=
