---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/sections/Hero.astro';
import Services from '../../components/sections/Services.astro';
import CalculatorTeaser from '../../components/sections/CalculatorTeaser.astro';
import PortfolioPreview from '../../components/sections/PortfolioPreview.astro';
import Process from '../../components/sections/Process.astro';
import Stats from '../../components/sections/Stats.astro';
import ServiceArea from '../../components/sections/ServiceArea.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout
  title={t('meta.defaultTitle')}
  description={t('meta.defaultDescription')}
  routeKey="home"
  overHero={true}
>
  <Hero locale={locale} />
  <Services locale={locale} />
  <CalculatorTeaser locale={locale} />
  <PortfolioPreview locale={locale} />
  <Process locale={locale} />
  <Stats locale={locale} />
  <ServiceArea locale={locale} />
  <FinalCTA locale={locale} />
</Layout>
