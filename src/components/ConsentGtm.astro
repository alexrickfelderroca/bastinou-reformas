---
/**
 * Consent Mode v2 + Google Tag Manager (CLAUDE.pdf §7 — Fase 7).
 *
 * Va en el <head>, lo ANTES posible. Emite dos scripts `is:inline` en este
 * orden estricto (Astro respeta el orden de fuente para is:inline y no los
 * difiere):
 *   1) DEFAULTS de Consent Mode — SIEMPRE se renderiza, aunque el tracking esté
 *      dormido. Deniega todo el almacenamiento no esencial (España = EEE →
 *      consentimiento previo) antes de que ninguna etiqueta pueda leer el estado.
 *      Reaplica una elección previa (granular, con caducidad) guardada en
 *      localStorage para no penalizar a quien ya consintió.
 *   2) Loader de GTM — SÓLO se inyecta con un ID de contenedor real (`gtmEnabled`).
 *      Con el placeholder no se hace ninguna petición a gtm.js.
 *
 * No incluimos el <noscript> de GTM a propósito: un visitante sin JS no puede
 * ejecutar los defaults ni ver el banner, así que cargar GTM para él dispararía
 * etiquetas sin consentimiento (prohibido en el EEE). La pérdida de medición de
 * usuarios sin JS es despreciable y elimina un agujero de cumplimiento.
 */
import { gtmId, gtmEnabled } from '../config/site';

// Loader oficial de GTM con el ID interpolado de forma segura (JSON.stringify).
// Se inyecta como JS crudo vía set:html para no depender del parseo de hijos.
const gtmLoader = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`;
---

{/* 1) Consent Mode v2 — defaults DENEGADOS + reaplicación de elección previa. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  // `set` (no son claves de consentimiento): redacción de identificadores de
  // anuncios mientras ad_storage está denegado + passthrough de gclid por URL.
  gtag('set', 'ads_data_redaction', true);
  gtag('set', 'url_passthrough', true);

  // Estado por defecto: todo lo no esencial DENEGADO. security_storage concedido
  // (esencial: seguridad/antifraude). wait_for_update da margen al banner.
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500,
  });

  gtag('js', new Date());

  // Reaplica una elección previa ANTES de cargar GTM (SSG = recargas completas;
  // Consent Mode no persiste el estado entre páginas). Registro granular con
  // caducidad de 180 días; si es inválido o ha caducado, se borra y el banner
  // volverá a pedir consentimiento (los defaults denegados siguen vigentes).
  try {
    var raw = localStorage.getItem('rbcn_consent');
    if (raw) {
      var c = JSON.parse(raw);
      var MAX_AGE = 1000 * 60 * 60 * 24 * 180;
      if (c && c.v === 1 && typeof c.ts === 'number' && Date.now() - c.ts < MAX_AGE) {
        var ads = c.marketing === 'granted' ? 'granted' : 'denied';
        gtag('consent', 'update', {
          analytics_storage: c.analytics === 'granted' ? 'granted' : 'denied',
          ad_storage: ads,
          ad_user_data: ads,
          ad_personalization: ads,
        });
      } else {
        localStorage.removeItem('rbcn_consent');
      }
    }
  } catch (e) {
    /* localStorage no disponible: se mantienen los defaults denegados. */
  }
</script>

{/* 2) Loader de GTM — sólo con un ID real (JS crudo vía set:html). */}
{gtmEnabled && <script is:inline set:html={gtmLoader} />}
