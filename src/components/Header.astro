---
/**
 * Cabecera del sitio. Logotipo AV Reforma BCN, navegación con desplegable de
 * Servicios, menú full-screen en móvil, selector de idioma, teléfono visible y
 * CTA principal («Solicitar visita»). Glassmorphism claro al hacer scroll
 * gestionado por data-scrolled en site.ts.
 *
 * `overHero`: cuando la cabecera arranca sobre un hero con foto oscura, el
 * texto inicial es blanco y el logotipo se pinta en blanco (filter). Al hacer
 * scroll aparece el cristal claro y el logo vuelve a su color.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/reforma-bcn-logo.png';
import { useTranslations, type Locale } from '../i18n/ui';
import { localizedPath, type RouteKey } from '../i18n/routes';
import { site, telHref, whatsappHref } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
  overHero?: boolean;
}
const { locale, routeKey, overHero = false } = Astro.props;
const t = useTranslations(locale);
const p = (k: RouteKey) => localizedPath(k, locale);

const services: RouteKey[] = ['viviendas', 'oficinas', 'tiendas', 'beauty'];
const primaryNav: RouteKey[] = ['precios', 'proyectos', 'contacto'];
const waPrefill = t('whatsapp.prefill');
const hasPhone = !site.phone.includes('[PENDIENTE');
---

<header
  class:list={['site-header', { 'site-header--over-dark': overHero }]}
  data-site-header
  data-scrolled="false"
>
  <a class="skip-link" href="#main">{t('header.skipToContent')}</a>

  <div class="site-header__bar container-x">
    <!-- Logotipo -->
    <a class="brand" href={p('home')} aria-label={t('meta.siteName')}>
      <Image src={logo} alt={t('meta.siteName')} class="brand__img" width={168} densities={[1, 2]} loading="eager" />
    </a>

    <!-- Navegación desktop -->
    <nav class="nav-desktop" aria-label="Principal">
      <a class="nav-link" href={p('nosotros')}>{t('nav.nosotros')}</a>
      <div class="nav-desktop__group" data-dropdown>
        <button class="nav-link nav-link--btn" aria-expanded="false" aria-haspopup="true" data-dropdown-toggle>
          {t('nav.servicios')}
          <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="dropdown" data-dropdown-menu>
          {services.map((s) => (
            <a class="dropdown__item" href={p(s)}>{t(`nav.${s}`)}</a>
          ))}
        </div>
      </div>
      {primaryNav.map((k) => (
        <a class="nav-link" href={p(k)}>{t(`nav.${k}`)}</a>
      ))}
    </nav>

    <!-- Acciones desktop -->
    <div class="header-actions">
      {hasPhone && (
        <a class="header-phone" href={telHref} data-phone>
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.6 1.8c.4-.4 1-.4 1.4 0l1.6 1.6c.4.4.4 1 0 1.4l-.8.8c-.2.2-.2.5-.1.7a9.2 9.2 0 0 0 4 4c.2.1.5.1.7-.1l.8-.8c.4-.4 1-.4 1.4 0l1.6 1.6c.4.4.4 1 0 1.4l-.9.9c-.5.5-1.2.7-1.9.5C8.1 12.9 3.1 7.9 1.9 4.6c-.2-.7 0-1.4.5-1.9l1.2-.9Z" fill="currentColor"/></svg>
          {site.phone}
        </a>
      )}
      <LanguageSwitcher locale={locale} routeKey={routeKey} />
      <a class="btn header-cta" href={p('contacto')}>{t('cta.visit')}</a>
    </div>

    <!-- Botón menú móvil -->
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="sr-only">{t('nav.menu')}</span>
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <path d="M4 8h18M4 13h18M4 18h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</header>

<!-- Menú full-screen móvil -->
<div class="mobile-menu on-dark" id="mobile-menu" data-mobile-menu hidden>
  <div class="mobile-menu__top container-x">
    <a class="brand brand--on-dark" href={p('home')} aria-label={t('meta.siteName')}>
      <Image src={logo} alt={t('meta.siteName')} class="brand__img" width={168} densities={[1, 2]} loading="lazy" />
    </a>
    <button class="menu-toggle" data-menu-close aria-label={t('nav.close')}>
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <path d="M6 6l14 14M20 6L6 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <nav class="mobile-menu__nav container-x" aria-label={t('nav.menu')}>
    <a class="mobile-menu__link" href={p('nosotros')}>{t('nav.nosotros')}</a>
    <span class="mobile-menu__label">{t('nav.servicios')}</span>
    {services.map((s) => (
      <a class="mobile-menu__link mobile-menu__link--sub" href={p(s)}>{t(`nav.${s}`)}</a>
    ))}
    {primaryNav.map((k) => (
      <a class="mobile-menu__link" href={p(k)}>{t(`nav.${k}`)}</a>
    ))}
  </nav>
  <div class="mobile-menu__footer container-x">
    <a class="btn btn-whatsapp" href={whatsappHref(waPrefill)} target="_blank" rel="noopener" data-wa data-wa-source="header">
      {t('cta.whatsapp')}
    </a>
    <a class="btn btn-outline" href={telHref} data-phone>{t('cta.call')}</a>
    <div class="mobile-menu__lang"><LanguageSwitcher locale={locale} routeKey={routeKey} /></div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    color: var(--color-ink);
  }
  /* Sobre hero con foto oscura: texto blanco de inicio. */
  .site-header--over-dark {
    color: #fff;
  }
  /* Al hacer scroll aparece el cristal claro: el texto vuelve a oscuro. */
  .site-header[data-scrolled='true'] {
    color: var(--color-ink);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 72px;
  }

  /* ---- Logotipo ---- */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  .brand :global(img) {
    display: block;
    width: clamp(128px, 14vw, 168px);
    height: auto;
    transition: filter 0.3s var(--ease-standard);
  }
  /* Sobre el hero oscuro (sin scroll) el logo se pinta en blanco. */
  .site-header--over-dark:not([data-scrolled='true']) .brand :global(img),
  .brand--on-dark :global(img) {
    filter: brightness(0) invert(1);
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 1.6rem;
    margin-inline-start: auto;
  }
  .nav-link,
  .nav-link--btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: currentColor;
    opacity: 0.85;
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .nav-link:hover,
  .nav-link--btn:hover {
    opacity: 1;
  }

  .nav-desktop__group {
    position: relative;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    min-width: 15rem;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgba(31, 55, 48, 0.12);
    border-radius: 0.9rem;
    box-shadow: 0 24px 50px -24px rgba(31, 55, 48, 0.35);
    display: grid;
    gap: 0.15rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }
  .nav-desktop__group[data-open='true'] .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .dropdown__item {
    padding: 0.65rem 0.85rem;
    border-radius: 0.6rem;
    color: var(--color-ink);
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .dropdown__item:hover {
    background: rgba(31, 55, 48, 0.08);
  }

  .header-actions {
    display: none;
    align-items: center;
    gap: 1.1rem;
  }
  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 550;
    color: currentColor;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.92;
  }
  .header-phone:hover {
    opacity: 1;
  }
  .header-cta {
    min-height: 2.5rem;
    padding: 0.6rem 1.15rem;
    font-size: 0.9rem;
  }
  /* CTA sobre hero oscuro: relleno blanco con texto verde para contrastar. */
  .site-header--over-dark:not([data-scrolled='true']) .header-cta {
    --btn-bg: #fff;
    --btn-fg: var(--color-deep);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-inline-end: -0.5rem;
    color: currentColor;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* ---- Menú full-screen móvil ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-deep);
    color: #fff;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mobile-menu[data-open='true'] {
    opacity: 1;
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    flex: none;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: 1.5rem;
    flex: 1;
    overflow-y: auto;
  }
  .mobile-menu__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.55);
    margin-block: 0.6rem 0.4rem;
  }
  .mobile-menu__link {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
    padding-block: 0.3rem;
  }
  .mobile-menu__link--sub {
    font-size: 1.1rem;
    font-weight: 500;
    opacity: 0.85;
    padding-left: 0.25rem;
  }
  .mobile-menu__footer {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex: none;
  }
  .mobile-menu__lang {
    margin-top: 0.25rem;
    color: #fff;
  }

  /* ---- Utilidades a11y ---- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0.5rem;
    z-index: 100;
    background: #fff;
    color: var(--color-deep);
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
  }
  .skip-link:focus {
    left: 1rem;
  }

  @media (min-width: 1024px) {
    .nav-desktop,
    .header-actions {
      display: flex;
    }
    .menu-toggle {
      display: none;
    }
  }
  /* El teléfono del header sólo cabe con holgura en pantallas amplias. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .header-phone {
      display: none;
    }
  }
</style>

<script>
  // Interacciones de la cabecera: desplegable de Servicios + menú móvil.

  // Desplegable Servicios (hover + click + teclado).
  const group = document.querySelector<HTMLElement>('[data-dropdown]');
  const toggle = group?.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
  if (group && toggle) {
    const setOpen = (open: boolean) => {
      group.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(group.dataset.open !== 'true'));
    group.addEventListener('mouseenter', () => setOpen(true));
    group.addEventListener('mouseleave', () => setOpen(false));
    document.addEventListener('click', (e) => {
      if (!group.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // Menú móvil full-screen con bloqueo de scroll.
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const openMenu = () => {
    if (!menu) return;
    menu.hidden = false;
    requestAnimationFrame(() => (menu.dataset.open = 'true'));
    document.body.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
  };
  const closeMenu = () => {
    if (!menu) return;
    menu.dataset.open = 'false';
    document.body.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    setTimeout(() => (menu.hidden = true), 300);
  };
  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) closeMenu();
  });
</script>
