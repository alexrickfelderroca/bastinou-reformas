---
/**
 * Página de contacto (§4.2): métodos de contacto (WhatsApp/teléfono/email),
 * formulario y zona de servicio + horario.
 */
import Layout from '../layouts/Layout.astro';
import QuoteForm from './sections/QuoteForm.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';
import { localizedPath } from '../i18n/routes';
import { breadcrumbLd } from '../lib/breadcrumbs';
import { site, telHref, whatsappHref } from '../config/site';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const siteUrl = Astro.site ?? new URL('https://kobor.es');
const crumbs = breadcrumbLd(siteUrl, [
  { name: t('landing.breadcrumbHome'), path: localizedPath('home', locale) },
  { name: t('nav.contacto'), path: localizedPath('contacto', locale) },
]);

const methods = [
  { label: t('cta.whatsapp'), value: site.phone, desc: t('contact.whatsappDesc'), href: whatsappHref(t('whatsapp.prefill')), attr: 'data-wa', ext: true },
  { label: t('common.phone'), value: site.phone, desc: t('contact.callDesc'), href: telHref, attr: 'data-phone', ext: false },
  { label: t('common.email'), value: site.email, desc: t('contact.emailDesc'), href: `mailto:${site.email}`, attr: '', ext: false },
];

const zones = ['Barcelona', "L'Hospitalet", 'Badalona', 'Sant Cugat', 'Sabadell', 'Terrassa', 'Maresme', 'Baix Llobregat', 'Girona', 'Tarragona'];
---

<Layout title={t('contact.metaTitle')} description={t('contact.metaDesc')} routeKey="contacto" overHero={true}>
  <section class="ct-hero on-dark">
    <div class="container-x">
      <h1 class="h-hero">{t('contact.title')}</h1>
      <p class="lead ct-hero__sub">{t('contact.subtitle')}</p>
    </div>
  </section>

  <section class="section ct-methods">
    <div class="container-x">
      <div class="ct-methods__grid" data-reveal-group data-reveal-stagger="80">
        {methods.map((m) => (
          <a
            class="ct-method card-hover"
            href={m.href}
            data-reveal
            data-wa={m.attr === 'data-wa' ? '' : undefined}
            data-wa-source={m.attr === 'data-wa' ? 'contact' : undefined}
            data-phone={m.attr === 'data-phone' ? '' : undefined}
            target={m.ext ? '_blank' : undefined}
            rel={m.ext ? 'noopener' : undefined}
          >
            <span class="ct-method__label">{m.label}</span>
            <span class="ct-method__value">{m.value}</span>
            <span class="ct-method__desc">{m.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <QuoteForm locale={locale} id="contacto-form" />

  <section class="section ct-info">
    <div class="container-x ct-info__grid">
      <div>
        <h2 class="h-section" data-reveal>{t('contact.areaTitle')}</h2>
        <p class="lead ct-info__text" data-reveal>{t('contact.areaText')}</p>
        <p class="ct-info__hours" data-reveal>
          <strong>{t('contact.hoursTitle')}:</strong> {t('contact.hoursValue')}
        </p>
      </div>
      <ul class="ct-zones" data-reveal-group data-reveal-stagger="40">
        {zones.map((z) => (
          <li class="ct-zone" data-reveal>{z}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section ct-map">
    <div class="container-x">
      <div class="ct-map__head">
        <div>
          <h2 class="h-section" data-reveal>{t('contact.mapTitle')}</h2>
          <p class="lead ct-map__text" data-reveal>{t('contact.mapText')}</p>
          <p class="ct-map__addr" data-reveal>
            {site.address.street} · {site.address.postalCode} Sant Cugat del Vallès
          </p>
        </div>
        <a class="btn btn-outline" href={site.maps.directionsUrl} target="_blank" rel="noopener" data-reveal>
          {t('contact.mapCta')}
        </a>
      </div>
      <div class="ct-map__frame" data-reveal>
        <iframe
          src={site.maps.embedUrl}
          title={t('contact.mapFrameTitle')}
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
</Layout>

<style>
  .ct-hero {
    background: var(--color-deep);
    color: #fff;
    padding-block: 8rem 3.5rem;
  }
  .ct-hero__sub {
    margin-top: 1.25rem;
    max-width: 48ch;
    color: rgba(255, 255, 255, 0.72);
  }
  .ct-methods {
    background: var(--color-paper);
  }
  .ct-methods__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .ct-method {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.75rem;
    border-radius: 1.25rem;
    border: 1px solid var(--color-line);
    background: var(--color-cloud);
    text-decoration: none;
    color: var(--color-ink);
  }
  .ct-method__label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-slate);
  }
  .ct-method__value {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .ct-method__desc {
    color: var(--color-slate);
    font-size: 0.95rem;
  }
  .ct-info {
    background: var(--color-cloud);
    border-top: 1px solid var(--color-line);
  }
  .ct-info__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .ct-info__text {
    margin-top: 1rem;
  }
  .ct-info__hours {
    margin-top: 1.5rem;
    color: var(--color-slate);
  }
  .ct-zones {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1rem;
  }
  .ct-zone {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-graphite);
  }
  .ct-map {
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .ct-map__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .ct-map__text {
    margin-top: 1rem;
    max-width: 48ch;
  }
  .ct-map__addr {
    margin-top: 0.75rem;
    color: var(--color-slate);
    font-size: 0.95rem;
  }
  /* Marco tipo tarjeta (bisel doble): bandeja clara + mapa embebido con radio
     concéntrico. El mapa descansa ligeramente desaturado para integrarse en la
     paleta y recupera el color al interactuar. */
  .ct-map__frame {
    padding: 0.5rem;
    border-radius: 1.25rem;
    border: 1px solid var(--color-line);
    background: var(--color-cloud);
    box-shadow:
      0 1px 2px rgba(31, 55, 48, 0.05),
      0 16px 40px -24px rgba(31, 55, 48, 0.25);
  }
  .ct-map__frame iframe {
    display: block;
    width: 100%;
    height: 380px;
    border: 0;
    border-radius: calc(1.25rem - 0.5rem);
    filter: saturate(0.35);
    transition: filter 0.5s var(--ease-standard);
  }
  .ct-map__frame:hover iframe,
  .ct-map__frame:focus-within iframe {
    filter: saturate(1);
  }
  @media (hover: none) {
    .ct-map__frame iframe {
      filter: none;
    }
  }
  @media (min-width: 768px) {
    .ct-methods__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .ct-info__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .ct-map__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2.5rem;
    }
    .ct-map__frame iframe {
      height: 460px;
    }
  }
</style>
