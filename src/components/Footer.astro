---
/**
 * Pie del sitio (banda verde oscura). Logotipo Kobor en blanco (filter sobre el
 * PNG transparente), columnas de servicios, empresa y contacto con teléfono, email,
 * WhatsApp, oficina y horario clicables/visibles, y la fila legal.
 */
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import logo from '../assets/brand/kobor-logo.png';
import { useTranslations, type Locale } from '../i18n/ui';
import { localizedPath, withTrailingSlash, type RouteKey } from '../i18n/routes';
import { site, telHref, whatsappHref } from '../config/site';
import { services as serviceCfg, serviceOrder } from '../config/services';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (k: RouteKey) => localizedPath(k, locale);
const year = new Date().getFullYear();

// Derivado de la configuración, igual que en el header: un servicio nuevo entra
// solo en el pie y no se queda sin enlaces internos.
const serviceLinks: RouteKey[] = serviceOrder.map((s) => serviceCfg[s].routeKey);
const companyLinks: RouteKey[] = ['precios', 'proyectos', 'guias', 'nosotros', 'contacto'];

// Las tres guías, con su slug REAL en el idioma del pie (mismo criterio que
// guias/[slug].astro: el slug público es el último segmento del id). El pie
// está en TODAS las páginas, y hasta hoy cada guía tenía UN solo enlace
// interno en todo el sitio — por eso el buscador no las conocía (26-08-2026).
const guideOrder = ['precio-reforma-piso', 'precio-reforma-bano', 'plazo-reforma-piso'];
const guias = (await getCollection('guias'))
  .filter((e: CollectionEntry<'guias'>) => e.data.lang === locale)
  .sort(
    (a: CollectionEntry<'guias'>, b: CollectionEntry<'guias'>) =>
      guideOrder.indexOf(a.data.translationKey) - guideOrder.indexOf(b.data.translationKey),
  );
const guideHref = (e: CollectionEntry<'guias'>): string =>
  withTrailingSlash(`${localizedPath('guias', locale)}/${e.id.split('/').pop()}`);

// La columna «empresa» con las tres guías desplegadas bajo su índice.
const companyList: { href: string; label: string }[] = companyLinks.flatMap((k) => {
  const base = { href: p(k), label: t(`nav.${k}`) };
  if (k !== 'guias') return [base];
  return [base, ...guias.map((e) => ({ href: guideHref(e), label: e.data.metaTitle }))];
});
const legalLinks: { key: RouteKey; label: string }[] = [
  { key: 'avisoLegal', label: t('footer.avisoLegal') },
  { key: 'privacidad', label: t('footer.privacidad') },
  { key: 'cookies', label: t('footer.cookies') },
];
const hasPhone = !site.phone.includes('[PENDIENTE');
---

<footer class="footer on-dark">
  <div class="container-x footer__grid">
    <div class="footer__brand">
      <a href={p('home')} aria-label={t('meta.siteName')}>
        <Image src={logo} alt={t('meta.siteName')} width={200} densities={[1, 2]} class="footer__logo" loading="lazy" />
      </a>
      <p class="footer__tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer__col" aria-label={t('footer.services')}>
      <h2 class="footer__title">{t('footer.services')}</h2>
      <ul>
        {serviceLinks.map((k) => (
          <li><a href={p(k)}>{t(`nav.${k}`)}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label={t('footer.company')}>
      <h2 class="footer__title">{t('footer.company')}</h2>
      <ul>
        {companyList.map(({ href, label }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">{t('footer.contactTitle')}</h2>
      <ul>
        {hasPhone && <li><a href={telHref} data-phone>{site.phone}</a></li>}
        <li>
          <a href={whatsappHref(t('whatsapp.prefill'))} target="_blank" rel="noopener" data-wa data-wa-source="footer">
            {t('cta.whatsapp')}
          </a>
        </li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.social.instagram && (
          <li><a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
        )}
        <li class="footer__area">{t('footer.office')}: {site.address.city}</li>
        <li class="footer__area">{t('footer.hours')}: {t('contact.hoursValue')}</li>
        <li class="footer__area">{t('footer.serviceArea')}</li>
      </ul>
    </div>
  </div>

  <div class="container-x footer__bottom">
    <p>© {year} {site.name}. {t('footer.rights')}</p>
    <ul class="footer__legal">
      {legalLinks.map(({ key, label }) => (
        <li><a href={p(key)}>{label}</a></li>
      ))}
      {/* Reabre las preferencias de cookies desde cualquier página (AEPD: retirar
          o cambiar el consentimiento debe ser tan fácil como darlo). */}
      <li>
        <button type="button" class="footer__legal-btn" data-consent="reopen" aria-haspopup="dialog" aria-controls="consent-settings">
          {t('consent.manage')}
        </button>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-deep);
    color: #fff;
    padding-top: var(--space-section);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 2rem;
    padding-bottom: 3rem;
  }
  .footer__brand {
    max-width: 22rem;
  }
  .footer__logo {
    width: 180px;
    height: auto;
    /* PNG transparente con texto verde oscuro → en blanco sobre la banda verde. */
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }
  .footer__tagline {
    margin-top: 1.1rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.975rem;
    line-height: 1.55;
  }
  .footer__title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    /* 0.55 daba 4.47:1 sobre --color-deep (falla AA por 0.03); 0.62 pasa. */
    color: rgba(255, 255, 255, 0.62);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .footer__col ul {
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .footer__col a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 0.975rem;
    transition: color 0.2s ease;
  }
  .footer__col a:hover {
    color: #fff;
  }
  .footer__area {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
  }
  .footer__legal {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .footer__legal a,
  .footer__legal-btn {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer__legal a:hover,
  .footer__legal-btn:hover {
    color: #fff;
  }
  /* El botón "Gestionar cookies" se ve exactamente como un enlace legal. */
  .footer__legal-btn {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    }
  }
</style>
