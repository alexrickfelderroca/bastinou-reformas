---
/**
 * Hero de la home. Fondo: vídeo cinemático en bucle "obra → reforma acabada"
 * (generado a partir de fotos reales del proyecto Casa en España), con capa
 * oscura para legibilidad.
 *
 * Disposición "hybrid" (rediseño con BrandLoader): un wordmark gigante "Bastinou"
 * ancla la parte inferior (como la referencia), acompañado de un titular-valor
 * (h1) y los dos CTA. El texto entra con un reveal enmascarado COORDINADO con el
 * BrandLoader mediante las clases `html.is-brandloading` (oculto) → `html.is-revealed`
 * (entra). Si el loader NO se reproduce (reduced-motion / repetición / sin-JS),
 * ninguna de esas clases se activa y el contenido es visible de inmediato.
 *
 * El vídeo:
 *  - Dos encuadres: 16:9 (escritorio) y 9:16 (móvil). Sólo se descarga uno,
 *    elegido por matchMedia en el cliente (ver <script>).
 *  - Bucle sin corte (crossfade horneado con ffmpeg) → `loop` nativo basta.
 *  - Grado "desaturado / cinemático" aplicado por CSS (filter), afinable aquí.
 *  - prefers-reduced-motion: no se carga vídeo; se ve el póster.
 */
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const wordmark = 'Bastinou'.split('');
---

<section class="hero on-dark">
  <div class="hero__media" aria-hidden="true">
    <div class="hero__poster"></div>
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      disablepictureinpicture
      aria-hidden="true"></video>
    <div class="hero__scrim"></div>
  </div>

  <div class="container-x hero__inner">
    <div class="hero__meta">
      <h1 class="hero__lede">
        <span class="hero__mask-inner" style="--rev-delay: 0.30s">
          {t('home.hero.line1')} {t('home.hero.line2')}
        </span>
      </h1>
      <div class="hero__actions">
        <a class="btn btn-invert" href={localizedPath('calculadora', locale)}>
          {t('home.hero.ctaCalc')}
        </a>
        <a class="btn btn-outline hero__ghost" href={localizedPath('proyectos', locale)}>
          {t('home.hero.ctaProjects')}
        </a>
      </div>
    </div>

    <div class="hero__brand" aria-hidden="true">
      {wordmark.map((l, i) => (
        <span class="hero__wm" style={`--rev-delay: ${(i * 0.035).toFixed(3)}s`}>{l}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-deep);
    color: #fff;
    /* Pantalla completa: evita que la costura hero/siguiente sección caiga
       detrás del botón flotante de WhatsApp. `svh` = sin salto por la barra
       del navegador móvil; `vh` como reserva para navegadores antiguos. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 8rem 4rem;
    overflow: hidden;
  }

  /* ---- Capa de fondo (vídeo + póster + scrim) ---- */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  /* Grado cinemático desaturado, compartido por vídeo y póster (afinable). */
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.5) contrast(1.03) brightness(0.88);
  }
  /* Póster (habitación acabada): visible de inmediato y sin JS / reduced-motion.
     Escritorio por defecto; móvil bajo el breakpoint. */
  .hero__poster {
    background-image: url('/hero/hero-desktop.jpg');
    background-size: cover;
    background-position: center;
    transform: scale(1.02); /* evita bordes con el filtro/escala del vídeo */
  }
  /* El vídeo entra por encima del póster cuando puede reproducirse. */
  .hero__video {
    opacity: 0;
    transition: opacity 0.9s var(--ease-standard, ease);
    transform: scale(1.02);
  }
  .hero__video.is-playing {
    opacity: 1;
  }

  /* Scrim para legibilidad del texto (sin filtro de color). Más oscuro abajo
     (donde va el wordmark) y arriba (para la cabecera translúcida). */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(10, 10, 10, 0.92) 0%,
        rgba(10, 10, 10, 0.78) 20%,
        rgba(10, 10, 10, 0.45) 48%,
        rgba(10, 10, 10, 0.34) 70%,
        rgba(10, 10, 10, 0.58) 100%
      );
  }

  @media (max-width: 800px) {
    .hero__poster {
      background-image: url('/hero/hero-mobile.jpg');
    }
    .hero__scrim {
      background:
        linear-gradient(
          to top,
          rgba(10, 10, 10, 0.94) 0%,
          rgba(10, 10, 10, 0.82) 26%,
          rgba(10, 10, 10, 0.5) 55%,
          rgba(10, 10, 10, 0.4) 78%,
          rgba(10, 10, 10, 0.62) 100%
        );
    }
  }

  /* ---- Contenido ---- */
  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 4vw, 3rem);
  }
  .hero__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 44rem;
  }
  .hero__lede {
    font-size: clamp(1.3rem, 2.6vw, 2.05rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    text-wrap: balance;
    /* Máscara del reveal (recorta el <span> interior) con aire para descendentes. */
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero__lede .hero__mask-inner {
    display: block;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero__ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(2px);
  }
  @media (hover: hover) {
    .hero__ghost:hover {
      background: #fff;
      color: var(--color-deep);
      border-color: #fff;
    }
  }

  /* ---- Wordmark gigante (decorativo) ---- */
  .hero__brand {
    display: flex;
    align-items: flex-end;
    color: #fff;
    font-weight: 560;
    font-size: clamp(2.75rem, 12.5vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    white-space: nowrap;
    /* Máscara del reveal por letras. */
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hero__wm {
    display: inline-block;
    will-change: transform;
  }

  /* ---- Reveal coordinado con el BrandLoader ----
     Solo se OCULTA mientras el loader va a reproducirse (html.is-brandloading);
     si no hay loader (reduced-motion / repetición / sin-JS) el contenido es
     visible por defecto (nunca queda oculto de forma permanente). */
  :global(html.is-brandloading) .hero__wm,
  :global(html.is-brandloading) .hero__lede .hero__mask-inner {
    transform: translateY(120%);
  }
  :global(html.is-brandloading) .hero__actions {
    opacity: 0;
    transform: translateY(24px);
  }

  :global(html.is-revealed) .hero__wm,
  :global(html.is-revealed) .hero__lede .hero__mask-inner {
    transform: translateY(0);
    transition: transform 1.15s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--rev-delay, 0s);
  }
  :global(html.is-revealed) .hero__actions {
    opacity: 1;
    transform: none;
    transition: opacity 1s ease, transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.42s;
  }

  /* Sin animación de vídeo: nos quedamos con el póster estático. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
    /* Por si acaso: nunca ocultar el contenido con movimiento reducido. */
    .hero__wm,
    .hero__lede .hero__mask-inner,
    .hero__actions {
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  /**
   * Carga el encuadre de vídeo adecuado (16:9 / 9:16) sin descargar los dos, y
   * respeta prefers-reduced-motion. Se difiere a idle para no dañar el LCP.
   */
  function initHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('.hero .hero__video');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const isMobile = window.matchMedia('(max-width: 800px)').matches;
    const base = isMobile ? '/hero/hero-mobile' : '/hero/hero-desktop';

    const webm = document.createElement('source');
    webm.src = `${base}.webm`;
    webm.type = 'video/webm';
    const mp4 = document.createElement('source');
    mp4.src = `${base}.mp4`;
    mp4.type = 'video/mp4';
    video.append(webm, mp4);

    video.addEventListener(
      'playing',
      () => video.classList.add('is-playing'),
      { once: true },
    );

    video.load();
    const attempt = video.play();
    if (attempt) attempt.catch(() => {});
  }

  if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(() => initHeroVideo(), { timeout: 2000 });
  } else {
    window.addEventListener('load', () => initHeroVideo());
  }
</script>
