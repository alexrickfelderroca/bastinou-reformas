---
/**
 * Hero de la home. Fondo: vídeo cinemático en bucle "obra → reforma acabada"
 * (generado a partir de fotos reales del proyecto Casa en España), con capa
 * oscura para legibilidad.
 *
 * Disposición "hybrid" (rediseño con BrandLoader): el wordmark gigante "kobor"
 * (glifos reales del logotipo, vectorizados en kobor-glyphs.json) ancla la parte
 * inferior (como la referencia), acompañado de un titular-valor
 * (h1) y los dos CTA. El texto entra con un reveal enmascarado COORDINADO con el
 * BrandLoader mediante las clases `html.is-brandloading` (oculto) → `html.is-revealed`
 * (entra). Si el loader NO se reproduce (reduced-motion / repetición / sin-JS),
 * ninguna de esas clases se activa y el contenido es visible de inmediato.
 *
 * El vídeo:
 *  - Dos encuadres: 16:9 (escritorio) y 9:16 (móvil). Sólo se descarga uno,
 *    elegido por matchMedia en el cliente (ver <script>).
 *  - Bucle sin corte (crossfade horneado con ffmpeg) → `loop` nativo basta.
 *  - Grado "desaturado / cinemático" aplicado por CSS (filter), afinable aquí.
 *  - prefers-reduced-motion: no se carga vídeo; se ve el póster.
 */
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';
import { whatsappHref } from '../../config/site';
import brand from '../../assets/brand/kobor-glyphs.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Glifos del wordmark (k · ob · o · r) en un sistema de coordenadas común:
// cada <svg> recorta su glifo con viewBox y se escala por --wm-h (altura k).
const VBH = brand.viewBox.h;
const wordmark = brand.glyphs;
const chips = [1, 2, 3].map((n) => ({
  t: t(`home.hero.chip${n}t`),
  d: t(`home.hero.chip${n}d`),
}));
---

<section class="hero on-dark">
  <div class="hero__media" aria-hidden="true">
    <div class="hero__poster"></div>
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      disablepictureinpicture
      aria-hidden="true"></video>
    <div class="hero__scrim"></div>
  </div>

  <div class="container-x hero__inner">
    <div class="hero__meta">
      <p class="hero__badge">
        <span class="hero__mask-inner" style="--rev-delay: 0.22s">{t('home.hero.badge')}</span>
      </p>
      <h1 class="hero__lede">
        <span class="hero__mask-inner" style="--rev-delay: 0.30s">
          {t('home.hero.line1')} {t('home.hero.line2')}
        </span>
      </h1>
      <p class="hero__sub">
        <span class="hero__mask-inner" style="--rev-delay: 0.38s">{t('home.hero.subtitle')}</span>
      </p>
      <div class="hero__actions">
        <a class="btn btn-invert" href={localizedPath('contacto', locale)}>
          {t('home.hero.ctaVisit')}
        </a>
        <a
          class="btn btn-whatsapp"
          href={whatsappHref(t('whatsapp.prefill'))}
          target="_blank"
          rel="noopener"
          data-wa
          data-wa-source="hero"
        >
          {t('home.hero.ctaWhatsapp')}
        </a>
      </div>
      <ul class="hero__chips">
        {chips.map((c) => (
          <li class="hero__chip">
            <strong>{c.t}</strong>
            <span>{c.d}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__brand" aria-hidden="true">
      {wordmark.map((g, i) => (
        <svg
          class="hero__wm"
          style={`--rev-delay: ${(i * 0.07).toFixed(3)}s; width: calc(var(--wm-h) * ${(g.w / VBH).toFixed(4)}); height: calc(var(--wm-h) * ${(g.h / VBH).toFixed(4)});`}
          viewBox={`${g.x} ${g.y} ${g.w} ${g.h}`}
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={g.d} fill-rule="evenodd" />
        </svg>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-deep);
    color: #fff;
    /* Pantalla completa: evita que la costura hero/siguiente sección caiga
       detrás del botón flotante de WhatsApp. `svh` = sin salto por la barra
       del navegador móvil; `vh` como reserva para navegadores antiguos. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 8rem 4rem;
    overflow: hidden;
  }

  /* ---- Capa de fondo (vídeo + póster + scrim) ---- */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  /* Grado cinemático desaturado, compartido por vídeo y póster (afinable). */
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.5) contrast(1.03) brightness(0.88);
  }
  /* Póster (habitación acabada): visible de inmediato y sin JS / reduced-motion.
     Escritorio por defecto; móvil bajo el breakpoint. */
  .hero__poster {
    background-image: url('/hero/hero-desktop.jpg');
    background-size: cover;
    background-position: center;
    transform: scale(1.02); /* evita bordes con el filtro/escala del vídeo */
  }
  /* El vídeo entra por encima del póster cuando puede reproducirse. */
  .hero__video {
    opacity: 0;
    transition: opacity 0.9s var(--ease-standard, ease);
    transform: scale(1.02);
  }
  .hero__video.is-playing {
    opacity: 1;
  }

  /* Scrim para legibilidad del texto (sin filtro de color). Más oscuro abajo
     (donde va el wordmark) y arriba (para la cabecera translúcida). */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(10, 10, 10, 0.92) 0%,
        rgba(10, 10, 10, 0.78) 20%,
        rgba(10, 10, 10, 0.45) 48%,
        rgba(10, 10, 10, 0.34) 70%,
        rgba(10, 10, 10, 0.58) 100%
      );
  }

  @media (max-width: 800px) {
    .hero__poster {
      background-image: url('/hero/hero-mobile.jpg');
    }
    .hero__scrim {
      background:
        linear-gradient(
          to top,
          rgba(10, 10, 10, 0.94) 0%,
          rgba(10, 10, 10, 0.82) 26%,
          rgba(10, 10, 10, 0.5) 55%,
          rgba(10, 10, 10, 0.4) 78%,
          rgba(10, 10, 10, 0.62) 100%
        );
    }
  }

  /* ---- Contenido ---- */
  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 4vw, 3rem);
  }
  .hero__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 44rem;
  }
  /* Badge de zona de servicio (chip translúcido sobre la foto). */
  .hero__badge {
    margin: 0;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero__badge .hero__mask-inner {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero__sub {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero__sub .hero__mask-inner {
    display: block;
  }
  .hero__lede {
    font-size: clamp(1.3rem, 2.6vw, 2.05rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    text-wrap: balance;
    /* Máscara del reveal (recorta el <span> interior) con aire para descendentes. */
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero__lede .hero__mask-inner {
    display: block;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  /* Chips de confianza (presupuesto claro · un solo equipo · zona). */
  .hero__chips {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
  }
  .hero__chip {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-left: 0.85rem;
    border-left: 2px solid rgba(255, 255, 255, 0.35);
  }
  .hero__chip strong {
    font-size: 0.95rem;
    font-weight: 620;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .hero__chip span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.68);
  }

  /* ---- Wordmark gigante (glifos reales del logo, decorativo) ---- */
  .hero__brand {
    /* Altura del glifo alto (k). El ancho total ≈ 4.1 × altura. */
    --wm-h: clamp(3.25rem, 16.5vw, 15rem);
    display: flex;
    align-items: flex-end;
    gap: calc(var(--wm-h) * 0.055);
    color: #fff;
    /* Máscara del reveal por glifos. */
    overflow: hidden;
    padding-bottom: calc(var(--wm-h) * 0.04);
    margin-bottom: calc(var(--wm-h) * -0.04);
  }
  .hero__wm {
    display: block;
    flex: none;
    will-change: transform;
  }

  /* ---- Reveal coordinado con el BrandLoader ----
     Solo se OCULTA mientras el loader va a reproducirse (html.is-brandloading);
     si no hay loader (reduced-motion / repetición / sin-JS) el contenido es
     visible por defecto (nunca queda oculto de forma permanente). */
  :global(html.is-brandloading) .hero__wm,
  :global(html.is-brandloading) .hero__mask-inner {
    transform: translateY(120%);
  }
  :global(html.is-brandloading) .hero__actions,
  :global(html.is-brandloading) .hero__chips {
    opacity: 0;
    transform: translateY(24px);
  }

  :global(html.is-revealed) .hero__wm,
  :global(html.is-revealed) .hero__mask-inner {
    transform: translateY(0);
    transition: transform 1.15s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--rev-delay, 0s);
  }
  :global(html.is-revealed) .hero__actions,
  :global(html.is-revealed) .hero__chips {
    opacity: 1;
    transform: none;
    transition: opacity 1s ease, transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.42s;
  }

  /* Sin animación de vídeo: nos quedamos con el póster estático. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
    /* Por si acaso: nunca ocultar el contenido con movimiento reducido. */
    .hero__wm,
    .hero__mask-inner,
    .hero__actions,
    .hero__chips {
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  /**
   * Carga el encuadre de vídeo adecuado (16:9 / 9:16) sin descargar los dos, y
   * respeta prefers-reduced-motion. Se difiere a idle para no dañar el LCP.
   */
  function initHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('.hero .hero__video');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const isMobile = window.matchMedia('(max-width: 800px)').matches;
    const base = isMobile ? '/hero/hero-mobile' : '/hero/hero-desktop';

    const webm = document.createElement('source');
    webm.src = `${base}.webm`;
    webm.type = 'video/webm';
    const mp4 = document.createElement('source');
    mp4.src = `${base}.mp4`;
    mp4.type = 'video/mp4';
    video.append(webm, mp4);

    video.addEventListener(
      'playing',
      () => video.classList.add('is-playing'),
      { once: true },
    );

    video.load();
    const attempt = video.play();
    if (attempt) attempt.catch(() => {});
  }

  if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(() => initHeroVideo(), { timeout: 2000 });
  } else {
    window.addEventListener('load', () => initHeroVideo());
  }
</script>
