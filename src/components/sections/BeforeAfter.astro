---
/**
 * Slider antes/después (§4.2, checklist). Funciona con ratón, touch y teclado:
 * construido sobre un <input type="range"> nativo (accesible) que controla la
 * posición del recorte (clip-path). Sin dependencias.
 */
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  ariaLabel: string;
}
const { before, after, beforeLabel, afterLabel, ariaLabel } = Astro.props;
---

<figure class="ba" data-ba style="--pos: 50%">
  <Image class="ba__img" src={after} alt={afterLabel} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 900px, 100vw" loading="lazy" />
  <div class="ba__clip">
    <Image class="ba__img" src={before} alt={beforeLabel} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 900px, 100vw" loading="lazy" />
  </div>

  <span class="ba__tag ba__tag--before">{beforeLabel}</span>
  <span class="ba__tag ba__tag--after">{afterLabel}</span>

  <div class="ba__line" aria-hidden="true">
    <span class="ba__grip">
      <svg width="18" height="18" viewBox="0 0 18 18"><path d="M7 4L3 9l4 5M11 4l4 5-4 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>

  <input class="ba__range" type="range" min="0" max="100" value="50" step="0.1" aria-label={ariaLabel} data-ba-range />
</figure>

<style>
  .ba {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-cloud);
    touch-action: none;
    user-select: none;
  }
  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ba__clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba__tag {
    position: absolute;
    top: 0.85rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    z-index: 3;
    pointer-events: none;
  }
  .ba__tag--before {
    left: 0.85rem;
  }
  .ba__tag--after {
    right: 0.85rem;
  }
  .ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: #fff;
    transform: translateX(-1px);
    z-index: 2;
    pointer-events: none;
  }
  .ba__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #fff;
    color: var(--color-deep);
    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.5);
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    z-index: 4;
  }
  .ba__range:focus-visible + .ba__line .ba__grip,
  .ba__range:focus-visible ~ .ba__line .ba__grip {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const sync = () => fig.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', sync);
    sync();
  });
</script>
