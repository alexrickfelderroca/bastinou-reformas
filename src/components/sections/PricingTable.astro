---
/**
 * Precios orientativos por segmento (§4.3). Lee pricing.json (placeholder) para
 * el tipo de servicio. Si pricingType es null (construcción) → "a medida".
 * Cifras placeholder: el precio exacto se da tras la visita.
 */
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';
import type { PricingType } from '../../config/services';
import pricing from '../../config/pricing.json';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
  pricingType: PricingType;
}
const { locale, pricingType } = Astro.props;
const t = useTranslations(locale);
const nf = new Intl.NumberFormat(locale === 'en' ? 'en' : 'es-ES');

type Seg = 'basico' | 'estandar' | 'premium';
const segMeta: { key: Seg; name: string; desc: string; featured?: boolean }[] = [
  { key: 'basico', name: t('landing.segBasico'), desc: t('landing.segBasicoDesc') },
  { key: 'estandar', name: t('landing.segEstandar'), desc: t('landing.segEstandarDesc'), featured: true },
  { key: 'premium', name: t('landing.segPremium'), desc: t('landing.segPremiumDesc') },
];

const rates = pricingType ? (pricing.integral as Record<string, Record<Seg, number>>)[pricingType] : null;
---

<section class="section pricing">
  <div class="container-x">
    <SectionHeader
      eyebrow={t('landing.perSqm')}
      title={t('landing.pricingTitle')}
      subtitle={t('landing.pricingSubtitle')}
    />

    {rates ? (
      <div class="pricing__grid" data-reveal-group data-reveal-stagger="90">
        {segMeta.map((seg) => (
          <div class:list={['pricing__card', { 'pricing__card--featured': seg.featured }]} data-reveal>
            <span class="pricing__seg">{seg.name}</span>
            <p class="pricing__price">
              <span class="pricing__from">{t('landing.from')}</span>
              <span class="pricing__amount">{nf.format(rates[seg.key])}</span>
              <span class="pricing__unit">{t('landing.perSqm')}</span>
            </p>
            <p class="pricing__desc">{seg.desc}</p>
            <a class:list={['btn', seg.featured ? '' : 'btn-outline']} href={localizedPath('calculadora', locale)}>
              {t('landing.ctaCalc')}
            </a>
          </div>
        ))}
      </div>
    ) : (
      <div class="pricing__custom" data-reveal>
        <h3 class="pricing__custom-title">{t('landing.pricingCustomTitle')}</h3>
        <p class="pricing__custom-desc">{t('landing.pricingCustomDesc')}</p>
        <a class="btn" href={localizedPath('contacto', locale)}>{t('cta.quote')}</a>
      </div>
    )}

    <p class="pricing__disclaimer">{t('landing.pricingDisclaimer')}</p>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-cloud);
  }
  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .pricing__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
  }
  .pricing__card--featured {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }
  .pricing__seg {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-slate);
  }
  .pricing__card--featured .pricing__seg {
    color: var(--color-mist);
  }
  .pricing__price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .pricing__from {
    font-size: 0.9rem;
    color: var(--color-slate);
  }
  .pricing__card--featured .pricing__from {
    color: var(--color-mist);
  }
  .pricing__amount {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .pricing__unit {
    font-size: 1rem;
    color: var(--color-slate);
  }
  .pricing__card--featured .pricing__unit {
    color: var(--color-mist);
  }
  .pricing__desc {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-slate);
    flex: 1;
  }
  .pricing__card--featured .pricing__desc {
    color: rgba(255, 255, 255, 0.75);
  }
  .pricing__card .btn {
    margin-top: 0.5rem;
  }
  .pricing__card--featured .btn {
    --btn-bg: #fff;
    --btn-fg: var(--color-ink);
  }

  .pricing__custom {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .pricing__custom-title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .pricing__custom-desc {
    color: var(--color-slate);
    margin: 0.75rem 0 1.5rem;
    line-height: 1.55;
  }

  .pricing__disclaimer {
    margin-top: 1.75rem;
    font-size: 0.85rem;
    /* Texto legal legible: slate (>=4.5:1 sobre claro); mist (#999) no pasa AA. */
    color: var(--color-slate);
    max-width: 46rem;
  }

  @media (min-width: 768px) {
    .pricing__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
