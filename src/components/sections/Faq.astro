---
/**
 * FAQ con schema FAQPage (§4.3, §8). Usa <details>/<summary> nativo:
 * accesible, funciona sin JS y es indexable. Emite JSON-LD FAQPage.
 */
import { useTranslations, type Locale } from '../../i18n/ui';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
  items: { q: string; a: string }[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---

<section class="section faq">
  <div class="container-x faq__wrap">
    <SectionHeader title={t('landing.faqTitle')} align="left" />
    <div class="faq__list" data-reveal-group data-reveal-stagger="60">
      {items.map((it) => (
        <details class="faq__item" data-reveal>
          <summary class="faq__q">
            <span>{it.q}</span>
            <svg class="faq__icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3v12M3 9h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </summary>
          <div class="faq__a"><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .faq {
    background: var(--color-paper);
  }
  .faq__wrap {
    max-width: 48rem;
  }
  .faq__list {
    display: grid;
    gap: 0.5rem;
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 0;
    font-size: 1.1rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    flex: none;
    color: var(--color-slate);
    transition: transform 0.3s var(--ease-standard);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }
  .faq__a {
    padding: 0 0 1.5rem;
    color: var(--color-slate);
    line-height: 1.6;
    max-width: 60ch;
  }
</style>
