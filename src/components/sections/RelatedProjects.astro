---
/**
 * Proyectos relacionados (§4.3). Con `service`, enseña obras de ese sector.
 * Sin servicio (landing de Ads) mantiene las tres tarjetas de siempre.
 * Los enlaces llevan barra final.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath, withTrailingSlash } from '../../i18n/routes';
import type { ServiceKey } from '../../config/services';
import { projectImageAlt } from '../../lib/image-alt';
import SectionHeader from './SectionHeader.astro';

import kitchen from '../../assets/portfolio/viviendas/v6-despues.jpg';
import bathroom from '../../assets/portfolio/viviendas/v10-despues.jpg';
import restaurant from '../../assets/portfolio/comerciales/c1-despues.jpg';

interface Props {
  locale: Locale;
  service?: ServiceKey;
}
const { locale, service } = Astro.props;
const t = useTranslations(locale);

/** Obras ya publicadas, por servicio. Solo slugs que existen en el portfolio. */
const slugsByService: Record<ServiceKey, string[]> = {
  integrales: ['piso-integral-barcelona', 'duplex-escalera-vidrio', 'salon-piso-clasico'],
  santCugat: ['duplex-escalera-vidrio', 'piso-integral-barcelona', 'salon-piso-clasico'],
  viviendas: ['piso-integral-barcelona', 'duplex-escalera-vidrio', 'cocina-blanca-madera'],
  cocinas: ['cocina-blanca-madera', 'cocina-comedor-marmol', 'piso-integral-barcelona'],
  oficinas: ['oficina-planta-abierta', 'oficina-zona-descanso'],
  tiendas: ['tienda-moda', 'supermercado-gourmet', 'restaurante-vigas'],
  beauty: ['peluqueria-beige', 'gimnasio-industrial'],
  banos: ['bano-verde-salvia', 'bano-rosa', 'bano-beige-madera'],
};

const projectsHref = withTrailingSlash(localizedPath('proyectos', locale));
const all = service ? await getCollection('projects') : [];
const tiles = service
  ? slugsByService[service]
      .map((slug) => all.find((entry) => entry.id === slug))
      .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined)
      .map((entry) => ({
        img: entry.data.cover,
        cap: t(`projects.${entry.id}.title`),
        slug: entry.id,
        alt: projectImageAlt({
          title: t(`projects.${entry.id}.title`),
          location: entry.data.location,
          inWord: t('project.altIn'),
          phase: t('project.altAfter'),
        }),
      }))
  : [
      { img: kitchen, cap: t('projects.cocina-comedor-marmol.title'), slug: 'cocina-comedor-marmol', alt: t('projects.cocina-comedor-marmol.title') },
      { img: bathroom, cap: t('projects.bano-verde-salvia.title'), slug: 'bano-verde-salvia', alt: t('projects.bano-verde-salvia.title') },
      { img: restaurant, cap: t('projects.restaurante-vigas.title'), slug: 'restaurante-vigas', alt: t('projects.restaurante-vigas.title') },
    ];
---

<section class="section related">
  <div class="container-x">
    <div class="related__head">
      <SectionHeader eyebrow={t('home.portfolio.eyebrow')} title={t('landing.relatedTitle')} />
      <a class="btn btn-outline related__cta" href={projectsHref}>
        {t('landing.relatedCta')}
      </a>
    </div>
    <div class="related__grid" data-reveal-group data-reveal-stagger="90">
      {tiles.map(({ img, cap, slug, alt }) => (
        <a class="related__tile card-hover" href={withTrailingSlash(`${localizedPath('proyectos', locale)}/${slug}`)} data-reveal>
          <div class="related__media">
            <Image src={img} alt={alt} widths={[380, 640]} sizes="(min-width: 768px) 33vw, 100vw" class="card-media" loading="lazy" />
          </div>
          <span class="related__cap">{cap}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related {
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .related__head :global(.sec-head) {
    margin-bottom: 0;
  }
  .related__cta {
    flex: none;
  }
  .related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .related__tile {
    position: relative;
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
  }
  .related__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .related__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .related__cap {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8rem;
  }
  @media (min-width: 768px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
