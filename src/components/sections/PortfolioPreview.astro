---
/**
 * Portfolio (home). Según el concepto: dos categorías visibles — Viviendas y
 * Locales comerciales — con fotografía grande y banda de título verde, más el
 * CTA «Ver todos los proyectos».
 */
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';
import SectionHeader from './SectionHeader.astro';

import imgViviendas from '../../assets/portfolio/viviendas/v3-despues.jpg';
import imgLocales from '../../assets/portfolio/comerciales/c1-despues.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const cats = [
  {
    img: imgViviendas,
    title: t('home.portfolio.catViviendas'),
    meta: t('home.portfolio.catViviendasMeta'),
  },
  {
    img: imgLocales,
    title: t('home.portfolio.catLocales'),
    meta: t('home.portfolio.catLocalesMeta'),
  },
];
---

<section class="section portfolio">
  <div class="container-x">
    <SectionHeader
      eyebrow={t('home.portfolio.eyebrow')}
      title={t('home.portfolio.title')}
      subtitle={t('home.portfolio.subtitle')}
    />

    <div class="portfolio__cats" data-reveal-group data-reveal-stagger="120">
      {cats.map(({ img, title, meta }) => (
        <a class="portfolio__cat card-hover" href={localizedPath('proyectos', locale)} data-reveal>
          <div class="portfolio__cat-media">
            <Image
              src={img}
              alt=""
              widths={[640, 1024, 1400]}
              sizes="(min-width: 900px) 50vw, 100vw"
              class="card-media"
              loading="lazy"
            />
          </div>
          <div class="portfolio__cat-band">
            <h3 class="portfolio__cat-title">{title}</h3>
            <p class="portfolio__cat-meta">{meta}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="portfolio__foot" data-reveal>
      <a class="btn" href={localizedPath('proyectos', locale)}>{t('home.portfolio.cta')}</a>
    </div>
  </div>
</section>

<style>
  .portfolio {
    background: var(--color-paper);
  }
  .portfolio__cats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .portfolio__cat {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-deep);
  }
  .portfolio__cat-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .portfolio__cat-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portfolio__cat-band {
    padding: 1.4rem 1.6rem 1.5rem;
    color: #fff;
  }
  .portfolio__cat-title {
    font-size: 1.35rem;
    font-weight: 640;
    letter-spacing: -0.015em;
  }
  .portfolio__cat-meta {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .portfolio__foot {
    margin-top: 2.25rem;
  }

  @media (min-width: 900px) {
    .portfolio__cats {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
</style>
