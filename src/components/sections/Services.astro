---
/**
 * Servicios — "Split-Reveal" impulsado por SCROLL.
 *
 * Adaptación del componente "Split-Reveal Studio Carousel" (Sliders). El original
 * (Vite + GSAP + SplitText + CustomEase) descubre cada obra a pantalla completa al
 * pulsar prev/next: la imagen entra con un recorte (clip-path) y el título en
 * mayúsculas se parte y cae carácter a carácter. Aquí se recrea el MISMO efecto
 * pero gobernado por el desplazamiento vertical: al hacer scroll, cada servicio
 * "aparece" (wipe de clip-path + cascada de caracteres) en lugar de pulsar de lado.
 *
 * Stack del proyecto: Astro + TS vainilla (sin GSAP). El scrub de scroll usa una
 * sección "pineada" con `position: sticky` y una única variable CSS `--p` por panel
 * (0→1) que CSS convierte en el recorte de la imagen y el retardo por carácter.
 *
 * Mejora progresiva y accesibilidad (requisitos del encargo):
 *  - Los 4 servicios (enlace + título + descripción) se renderizan en el servidor
 *    como una lista semántica legible. SIN JS o con prefers-reduced-motion se ve
 *    esa lista apilada normal — el contenido NUNCA queda oculto (SEO/no-JS).
 *  - Con JS + movimiento permitido, `is-enhanced` transforma la lista en la
 *    secuencia pineada a pantalla completa. Si el script falla, se queda la lista.
 *  - Re-tematizado 100% a los tokens del proyecto (nada de la paleta ref).
 */
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath, type RouteKey } from '../../i18n/routes';
import SectionHeader from './SectionHeader.astro';

import imgViviendas from '../../assets/portfolio/viviendas/v6-despues.jpg';
import imgOficinas from '../../assets/portfolio/comerciales/c3-despues.jpg';
import imgTiendas from '../../assets/portfolio/comerciales/c7-despues.jpg';
import imgBeauty from '../../assets/portfolio/comerciales/c5-despues.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const items: { key: RouteKey; img: ImageMetadata }[] = [
  { key: 'viviendas', img: imgViviendas },
  { key: 'oficinas', img: imgOficinas },
  { key: 'tiendas', img: imgTiendas },
  { key: 'beauty', img: imgBeauty },
];
const N = items.length;

/**
 * Parte un título en PALABRAS y, dentro de cada palabra, en caracteres, con un
 * índice global continuo (para el retardo de la cascada). Agrupar por palabras
 * evita que la línea se rompa a mitad de palabra: sólo hay salto en los espacios.
 */
function layoutTitle(text: string) {
  const words = text.split(' ');
  let ci = 0;
  return words.map((word) => ({
    chars: Array.from(word).map((ch) => ({ ch, i: ci++ })),
  }));
}
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  class="section svc-reveal"
  data-svc-reveal
  style={`--n:${N}`}
>
  <div class="container-x svc-reveal__head">
    <SectionHeader
      eyebrow={t('home.services.eyebrow')}
      title={t('home.services.title')}
      subtitle={t('home.services.subtitle')}
    />
  </div>

  <div class="svc-reveal__track">
    <div class="svc-reveal__vp">
      <ol class="svc-reveal__panels">
        {items.map(({ key, img }, i) => {
          const title = t(`home.services.${key}T`);
          return (
            <li class="svc-reveal__panel-wrap">
              <a
                class="svc-panel"
                data-svc-panel
                href={localizedPath(key, locale)}
                style={`--i:${i}`}
                aria-label={`${title} — ${t('home.services.cta')}`}
              >
                <div class="svc-panel__media">
                  <Image
                    class="svc-panel__img"
                    src={img}
                    alt={title}
                    widths={[640, 1024, 1600]}
                    sizes="(min-width: 768px) 100vw, 100vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <span class="svc-panel__scrim" aria-hidden="true"></span>
                </div>

                <div class="svc-panel__content container-x">
                  <span class="svc-panel__index" aria-hidden="true">
                    <em>{pad(i + 1)}</em><span class="svc-panel__index-sep">/</span>{pad(N)}
                  </span>
                  <h3 class="svc-panel__title" aria-label={title}>
                    {layoutTitle(title).map((word, wi, arr) => (
                      <>
                        <span class="svc-panel__word">
                          {word.chars.map(({ ch, i }) => (
                            <span class="svc-panel__char" style={`--char-i:${i}`} aria-hidden="true">{ch}</span>
                          ))}
                        </span>
                        {wi < arr.length - 1 && <span class="svc-panel__space" aria-hidden="true"> </span>}
                      </>
                    ))}
                  </h3>
                  <p class="svc-panel__desc">{t(`home.services.${key}`)}</p>
                  <span class="svc-panel__cta">
                    {t('home.services.cta')}
                    <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ol>

      <div class="svc-reveal__rail" aria-hidden="true">
        {items.map((_, i) => (
          <span class="svc-reveal__tick" data-svc-tick style={`--i:${i}`}>{pad(i + 1)}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .svc-reveal {
    background: var(--color-paper);
    position: relative;
  }
  .svc-reveal__head {
    margin-bottom: 2.5rem;
  }

  /* ---------- BASE (sin JS / reduced-motion): lista apilada legible ---------- */
  .svc-reveal__track { position: relative; }
  .svc-reveal__vp { position: relative; }
  .svc-reveal__panels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .svc-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 22rem;
    border-radius: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: var(--color-deep);
    isolation: isolate;
  }
  .svc-panel__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .svc-panel__media :global(img),
  .svc-panel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .svc-panel__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 14, 17, 0.92) 0%,
      rgba(13, 14, 17, 0.55) 42%,
      rgba(13, 14, 17, 0.12) 78%,
      rgba(13, 14, 17, 0.35) 100%
    );
  }
  .svc-panel__content {
    position: relative;
    z-index: 1;
    padding-block: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
    width: 100%;
  }
  .svc-panel__index {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.65);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .svc-panel__index em {
    font-style: normal;
    color: #a9c0ad; /* salvia clara, legible sobre la foto oscura */
    font-weight: 600;
  }
  .svc-panel__index-sep { opacity: 0.5; }

  .svc-panel__title {
    font-family: var(--font-sans);
    text-transform: uppercase;
    font-weight: 620;
    line-height: 0.95;
    letter-spacing: -0.01em;
    font-size: clamp(2rem, 5.2vw, 4.5rem);
    max-width: 16ch;
  }
  /* Agrupar caracteres por palabra evita saltos a mitad de palabra: la línea
     sólo puede romper en los espacios (.svc-panel__space). */
  .svc-panel__word {
    display: inline-block;
    white-space: nowrap;
  }
  .svc-panel__space {
    display: inline;
    white-space: pre;
  }
  .svc-panel__char {
    display: inline-block;
    white-space: pre;
  }
  .svc-panel__desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 44ch;
  }
  .svc-panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-weight: 550;
    color: #fff;
  }
  .svc-panel__cta svg {
    transition: transform 0.3s var(--ease-standard);
  }
  @media (hover: hover) {
    .svc-panel:hover .svc-panel__cta svg { transform: translateX(5px); }
  }

  .svc-reveal__rail { display: none; }

  /* --------------------- MEJORADO (JS + movimiento OK) --------------------- */
  .svc-reveal.is-enhanced .svc-reveal__head { margin-bottom: 0; }

  /* Pista alta: gobierna cuánto dura el "pin". Distancia de scrub por transición
     ≈ 85vh; la sección pineada cubre el alto del viewport + (N-1) transiciones. */
  .svc-reveal.is-enhanced .svc-reveal__track {
    height: calc(100vh + (var(--n) - 1) * 85vh);
  }
  .svc-reveal.is-enhanced .svc-reveal__vp {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: clip;
  }
  .svc-reveal.is-enhanced .svc-reveal__panels {
    display: block;
    gap: 0;
    height: 100%;
  }
  .svc-reveal.is-enhanced .svc-reveal__panel-wrap {
    position: absolute;
    inset: 0;
    z-index: calc(var(--n-panel, 0));
  }
  .svc-reveal.is-enhanced .svc-panel {
    position: absolute;
    inset: 0;
    height: 100vh;
    min-height: 0;
    border-radius: 0;
    z-index: calc(var(--i) + 1);
    /* Recorte gobernado por --p (0 = oculto abajo, 1 = a pantalla completa).
       El panel 0 arranca a 1 (siempre visible); el resto se descubren al scrollear. */
    clip-path: inset(calc((1 - var(--p, 1)) * 100%) 0 0 0);
    will-change: clip-path;
  }
  .svc-reveal.is-enhanced .svc-panel__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-block: 2rem 4.5rem;
    gap: 1.1rem;
  }
  .svc-reveal.is-enhanced .svc-panel__img {
    transform: scale(calc(1.14 - var(--p, 1) * 0.14));
    will-change: transform;
  }
  /* Cascada por carácter: cada letra revela según --p con retardo por índice.
     cp = clamp(0, (p - i*paso) / duración, 1). CSS hace toda la matemática;
     el JS sólo escribe --p en cada panel. */
  .svc-reveal.is-enhanced .svc-panel__char {
    --cp: clamp(0, calc((var(--p, 1) - var(--char-i) * 0.026) / 0.5), 1);
    transform: translateY(calc((1 - var(--cp)) * 0.9em));
    opacity: var(--cp);
    filter: blur(calc((1 - var(--cp)) * 12px));
    will-change: transform, opacity, filter;
  }
  .svc-reveal.is-enhanced .svc-panel__index,
  .svc-reveal.is-enhanced .svc-panel__desc,
  .svc-reveal.is-enhanced .svc-panel__cta {
    opacity: clamp(0, calc((var(--p, 1) - 0.25) / 0.4), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p, 1) - 0.25) / 0.4), 1)) * 1.2rem));
  }

  /* Raíl de progreso numérico (01–04). */
  .svc-reveal.is-enhanced .svc-reveal__rail {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    position: absolute;
    right: clamp(1.25rem, 4vw, 4rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    pointer-events: none;
  }
  .svc-reveal__tick {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.35s var(--ease-standard), transform 0.35s var(--ease-standard);
  }
  .svc-reveal__tick.is-active {
    color: #fff;
    transform: translateX(-4px);
  }

  @media (max-width: 767px) {
    .svc-reveal.is-enhanced .svc-panel__content { padding-block: 1.5rem 3.5rem; }
    .svc-reveal.is-enhanced .svc-reveal__rail { right: 1rem; }
  }

  /* Blindaje: si por lo que sea se queda en modo mejorado sin scrub, con
     prefers-reduced-motion forzamos la lista apilada legible. */
  @media (prefers-reduced-motion: reduce) {
    .svc-reveal.is-enhanced .svc-reveal__track { height: auto; }
    .svc-reveal.is-enhanced .svc-reveal__vp { position: relative; height: auto; overflow: visible; }
    .svc-reveal.is-enhanced .svc-reveal__panels { display: grid; gap: 1.5rem; }
    .svc-reveal.is-enhanced .svc-reveal__panel-wrap { position: relative; inset: auto; }
    .svc-reveal.is-enhanced .svc-panel {
      position: relative; height: auto; min-height: 22rem; border-radius: 1.25rem;
      clip-path: none;
    }
    .svc-reveal.is-enhanced .svc-panel__content { position: relative; }
    .svc-reveal.is-enhanced .svc-panel__char { transform: none; opacity: 1; filter: none; }
    .svc-reveal.is-enhanced .svc-panel__index,
    .svc-reveal.is-enhanced .svc-panel__desc,
    .svc-reveal.is-enhanced .svc-panel__cta { opacity: 1; transform: none; }
    .svc-reveal.is-enhanced .svc-reveal__rail { display: none; }
  }
</style>

<script>
  /**
   * Scrub de scroll para el Split-Reveal. Sólo mejora si hay movimiento permitido.
   * Escribe una variable CSS `--p` (0→1) por panel; CSS convierte eso en el recorte
   * de la imagen y la cascada por carácter. Si esto no corre, queda la lista base.
   */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('[data-svc-reveal]');

  if (section && !reduce) {
    const track = section.querySelector<HTMLElement>('.svc-reveal__track')!;
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-svc-panel]'));
    const ticks = Array.from(section.querySelectorAll<HTMLElement>('[data-svc-tick]'));
    const N = panels.length;
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

    section.classList.add('is-enhanced');

    let ticking = false;
    let lastActive = -1;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const rect = track.getBoundingClientRect();
      const total = track.offsetHeight - vh;
      const scrolled = clamp(-rect.top, 0, total);
      const P = total > 0 ? scrolled / total : 0;

      for (let i = 0; i < N; i++) {
        // r_i = clamp(P*(N-1) - (i-1), 0, 1): el panel 0 siempre a 1, el resto
        // se descubren por orden a medida que P avanza.
        const r = clamp(P * (N - 1) - (i - 1), 0, 1);
        panels[i].style.setProperty('--p', r.toFixed(4));
      }

      const active = Math.round(P * (N - 1));
      if (active !== lastActive) {
        lastActive = active;
        for (let i = 0; i < ticks.length; i++) ticks[i].classList.toggle('is-active', i === active);
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
