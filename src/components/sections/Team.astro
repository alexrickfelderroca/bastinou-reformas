---
/**
 * Equipo (Nosotros). Usa las 4 fotos reales del equipo. Nombres y cargos son
 * [PENDIENTE] hasta que los facilite la empresa (no inventamos datos de personas).
 */
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../../i18n/ui';
import SectionHeader from './SectionHeader.astro';

import t1 from '../../assets/team/team-01.jpg';
import t2 from '../../assets/team/team-02.jpg';
import t3 from '../../assets/team/team-03.jpg';
import t4 from '../../assets/team/team-04.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const members = [t1, t2, t3, t4];
---

<section class="section team">
  <div class="container-x">
    <SectionHeader eyebrow={t('about.eyEquipo')} title={t('about.teamTitle')} subtitle={t('about.teamSubtitle')} />
    <div class="team__grid" data-reveal-group data-reveal-stagger="80">
      {members.map((img) => (
        <figure class="team__card card-hover" data-reveal>
          <div class="team__media">
            <Image src={img} alt={t('about.teamName')} widths={[320, 560]} sizes="(min-width: 768px) 25vw, 50vw" class="card-media" loading="lazy" />
          </div>
          <figcaption class="team__cap">
            <span class="team__name">{t('about.teamName')}</span>
            <span class="team__role">{t('about.teamRole')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .team {
    background: var(--color-paper);
  }
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .team__card {
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-cloud);
    border: 1px solid var(--color-line);
  }
  .team__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .team__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .team__cap {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .team__name {
    font-weight: 600;
  }
  .team__role {
    font-size: 0.9rem;
    color: var(--color-slate);
  }
  @media (min-width: 768px) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
