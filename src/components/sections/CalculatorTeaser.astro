---
/**
 * Calculadora resumida (home). Sección oscura que empuja a /calculadora
 * (el wizard completo llega en Fase 4). Muestra la propuesta de valor + un
 * "mock" con efecto cristal del resultado.
 */
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const bullets = [t('home.calc.b1'), t('home.calc.b2'), t('home.calc.b3')];
---

<section class="section calc on-dark">
  <div class="container-x calc__grid">
    <div class="calc__content" data-reveal-group>
      <p class="calc__eyebrow" data-reveal>{t('home.calc.eyebrow')}</p>
      <h2 class="h-section" data-reveal>{t('home.calc.title')}</h2>
      <p class="lead calc__sub" data-reveal>{t('home.calc.subtitle')}</p>
      <ul class="calc__bullets" data-reveal>
        {bullets.map((b) => (
          <li>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9.5l3.5 3.5L15 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      <a class="btn btn-invert" href={localizedPath('calculadora', locale)} data-reveal>
        {t('home.calc.cta')}
      </a>
    </div>

    <!-- Mock del resultado con glassmorphism -->
    <div class="calc__mock" data-reveal aria-hidden="true">
      <div class="calc__glass">
        <span class="calc__mock-label">{t('home.calc.eyebrow')}</span>
        <div class="calc__chips">
          <span class="calc__chip">Piso</span>
          <span class="calc__chip">Integral</span>
          <span class="calc__chip">85 m²</span>
          <span class="calc__chip calc__chip--on">Estándar</span>
        </div>
        <div class="calc__range">
          <span class="calc__range-label">Precio estimado</span>
          <span class="calc__range-value">47.000 – 63.000&nbsp;€</span>
        </div>
        <div class="calc__bar"><span></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .calc {
    background: var(--color-deep);
    color: #fff;
  }
  .calc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  .calc__eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-mist);
    margin-bottom: 1rem;
  }
  .calc__sub {
    margin-top: 1.1rem;
    max-width: 40ch;
    color: rgba(255, 255, 255, 0.72);
  }
  .calc__bullets {
    list-style: none;
    display: grid;
    gap: 0.85rem;
    margin: 1.75rem 0 2.25rem;
  }
  .calc__bullets li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1rem;
  }
  .calc__bullets svg {
    flex: none;
    color: #fff;
  }

  /* Mock */
  .calc__glass {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.5rem;
    padding: 1.75rem;
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .calc__mock-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-mist);
  }
  .calc__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
  }
  .calc__chip {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
  }
  .calc__chip--on {
    background: #fff;
    color: var(--color-deep);
    border-color: #fff;
    font-weight: 600;
  }
  .calc__range-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-mist);
    margin-bottom: 0.3rem;
  }
  .calc__range-value {
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .calc__bar {
    margin-top: 1.25rem;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .calc__bar span {
    display: block;
    width: 68%;
    height: 100%;
    border-radius: 999px;
    background: #fff;
  }

  @media (min-width: 900px) {
    .calc__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 4rem;
    }
  }
</style>
