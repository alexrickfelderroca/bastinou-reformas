---
/**
 * Bloque CTA a la calculadora (§4.3, punto 7). Franja compacta que empuja a
 * /calculadora entre secciones.
 */
import { useTranslations, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="calc-cta on-dark">
  <div class="container-x calc-cta__inner" data-reveal-group>
    <div class="calc-cta__text" data-reveal>
      <h2 class="calc-cta__title">{t('landing.ctaBlockTitle')}</h2>
      <p class="calc-cta__sub">{t('landing.ctaBlockSub')}</p>
    </div>
    <a class="btn btn-invert" href={localizedPath('calculadora', locale)} data-reveal>
      {t('landing.ctaBlockCta')}
    </a>
  </div>
</section>

<style>
  .calc-cta {
    background: var(--color-deep);
    color: #fff;
  }
  .calc-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .calc-cta__title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .calc-cta__sub {
    color: rgba(255, 255, 255, 0.7);
    margin-top: 0.4rem;
  }
</style>
