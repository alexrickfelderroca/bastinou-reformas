---
/**
 * Guía individual (contenido editorial que empuja a las páginas de dinero).
 *
 * A diferencia del portfolio, aquí el texto vive en el .md: hay un archivo por
 * idioma bajo `src/content/guias/<lang>/` y `translationKey` une las versiones.
 * La URL pública es /guias/<slug>/ (sin el idioma dentro del path), por eso el
 * slug es el último segmento del id de la entrada.
 *
 * Cabecera editorial clara → portada → cuerpo con sumario → FAQ → CTA →
 * guías relacionadas. Todo el texto de interfaz sale de los diccionarios; del
 * .md sólo salen el contenido de la guía y sus preguntas frecuentes.
 *
 * SEO (§8): Article + BreadcrumbList + FAQPage. El bloque FAQPage se genera
 * desde el MISMO `entry.data.faq` que se pinta en pantalla (nunca preguntas
 * ocultas), y se omite por completo si la guía no tiene FAQ. Autor y editor
 * referencian por @id la única entidad de negocio que emite el Layout.
 */
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../sections/SectionHeader.astro';
import { useTranslations, localeHtmlLang, type Locale } from '../../i18n/ui';
import { localizedPath, withTrailingSlash, type RouteKey } from '../../i18n/routes';
import { whatsappHref } from '../../config/site';
import { breadcrumbLd } from '../../lib/breadcrumbs';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'guias'>;
  /** hreflang explícitos: sólo los idiomas que tienen traducción real. */
  alternates: { locale: Locale; path: string }[];
  relatedEntries: CollectionEntry<'guias'>[];
}

const { locale, entry, alternates, relatedEntries } = Astro.props;
const t = useTranslations(locale);
const d = entry.data;
const { Content, headings } = await render(entry);

/** Slug público de una guía: último segmento del id (los .md van en es/, ca/, en/). */
const slugOf = (e: CollectionEntry<'guias'>): string => e.id.split('/').pop() ?? e.id;
const guideHref = (e: CollectionEntry<'guias'>): string =>
  withTrailingSlash(`${localizedPath('guias', locale)}/${slugOf(e)}`);

/**
 * Tarjeta social propia de cada guía: la portada real de la obra recortada a
 * 1200×630. Sin esto las guías caerían en la imagen OG genérica del sitio, y al
 * compartirlas por WhatsApp —el canal principal— no se vería la foto del
 * proyecto. Se genera en el build, así que no añade trabajo en cliente.
 */
const ogCard = await getImage({
  src: d.cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 78,
});

const indexPath = withTrailingSlash(localizedPath('guias', locale));
const moneyKey = d.moneyPage as RouteKey;
const moneyPath = withTrailingSlash(localizedPath(moneyKey, locale));
const contactPath = withTrailingSlash(localizedPath('contacto', locale));

// Fechas: formato natural del idioma en pantalla, ISO en el atributo datetime.
const dateFmt = new Intl.DateTimeFormat(localeHtmlLang[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isoDay = (value: Date): string => value.toISOString().slice(0, 10);

// Sumario: sólo con suficientes h2 para que aporte algo (el h1 es el título).
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

const siteUrl = Astro.site ?? new URL('https://kobor.es');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const businessId = `${siteUrl.href}#business`;
const coverUrl = new URL(d.cover.src, siteUrl).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  image: coverUrl,
  datePublished: isoDay(d.pubDate),
  dateModified: isoDay(d.updatedDate ?? d.pubDate),
  inLanguage: localeHtmlLang[locale],
  mainEntityOfPage: canonical,
  // Una sola entidad de negocio en todo el sitio: aquí sólo se referencia.
  author: { '@id': businessId },
  publisher: { '@id': businessId },
};

const crumbsLd = breadcrumbLd(siteUrl, [
  { name: t('landing.breadcrumbHome'), path: localizedPath('home', locale) },
  { name: t('guias.breadcrumb'), path: localizedPath('guias', locale) },
  { name: d.title, path: Astro.url.pathname },
]);

const faqLd = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((it) => ({
        '@type': 'Question',
        name: it.q,
        acceptedAnswer: { '@type': 'Answer', text: it.a },
      })),
    }
  : null;
---

<Layout
  title={d.metaTitle}
  description={d.metaDescription}
  routeKey="guias"
  alternates={alternates}
  image={ogCard.src}
>
  <article class="guide">
    <header class="guide__head">
      <div class="container-x">
        <div class="guide__head-inner" data-reveal-group data-reveal-stagger="70">
          <a class="guide__eyebrow" href={indexPath} data-reveal>
            <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true">
              <path d="M5.2 1 1 5l4.2 4M1 5h12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t('guias.breadcrumb')}
          </a>
          <h1 class="guide__title" data-reveal>{d.title}</h1>
          <p class="lead guide__excerpt" data-reveal>{d.excerpt}</p>
          <p class="guide__meta" data-reveal>
            <time datetime={isoDay(d.pubDate)}>{dateFmt.format(d.pubDate)}</time>
            <span class="guide__dot" aria-hidden="true">·</span>
            <span>{d.readingMinutes} {t('guias.readingLabel')}</span>
            {d.updatedDate && (
              <Fragment>
                <span class="guide__dot" aria-hidden="true">·</span>
                <span>
                  {t('guias.updatedLabel')}{' '}
                  <time datetime={isoDay(d.updatedDate)}>{dateFmt.format(d.updatedDate)}</time>
                </span>
              </Fragment>
            )}
          </p>
        </div>
      </div>
    </header>

    <div class="guide__cover container-x">
      <div class="guide__cover-frame">
        <Image
          src={d.cover}
          alt={d.coverAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1216px) 1152px, calc(100vw - 2.5rem)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="guide__body">
      <div class:list={['container-x', 'guide__layout', { 'guide__layout--toc': showToc }]}>
        {showToc && (
          <nav class="guide__toc" aria-labelledby="guide-toc-title">
            <p class="guide__toc-title" id="guide-toc-title">{t('guias.tocTitle')}</p>
            <ol class="guide__toc-list">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    {d.faq.length > 0 && (
      <section class="section guide__faq">
        <div class="container-x">
          <div class="guide__faq-wrap">
            <SectionHeader title={t('guias.faqTitle')} align="left" />
            <div class="guide__faq-list" data-reveal-group data-reveal-stagger="60">
              {d.faq.map((it) => (
                <details class="guide__faq-item" data-reveal>
                  <summary class="guide__faq-q">
                    <span>{it.q}</span>
                    <svg class="guide__faq-icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                      <path d="M9 3v12M3 9h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                  </summary>
                  <div class="guide__faq-a"><p>{it.a}</p></div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="section guide__cta on-dark">
      <div class="container-x">
        <div class="guide__cta-inner" data-reveal-group data-reveal-stagger="70">
          <h2 class="h-section" data-reveal>{t('guias.ctaTitle')}</h2>
          <p class="lead guide__cta-text" data-reveal>{t('guias.ctaText')}</p>
          <div class="guide__cta-actions" data-reveal>
            <a class="btn btn-invert" href={contactPath}>{t('guias.ctaButton')}</a>
            <a
              class="btn btn-whatsapp"
              href={whatsappHref(t('whatsapp.prefill'))}
              target="_blank"
              rel="noopener"
              data-wa
              data-wa-source="guia"
            >
              {t('cta.whatsapp')}
            </a>
          </div>
          <a class="guide__cta-money" href={moneyPath} data-reveal>
            {t(`nav.${moneyKey}`)}
            <svg width="15" height="10" viewBox="0 0 15 10" aria-hidden="true">
              <path d="M9.6 1 13.8 5 9.6 9M13.8 5H1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="section guide__related">
      <div class="container-x">
        <div class="guide__related-head">
          <SectionHeader title={t('guias.relatedTitle')} align="left" />
          <a class="btn btn-outline guide__related-cta" href={indexPath}>{t('guias.backToIndex')}</a>
        </div>

        {relatedEntries.length > 0 && (
          <div class="guide__related-grid" data-reveal-group data-reveal-stagger="90">
            {relatedEntries.map((rel) => (
              <a class="guide-card card-hover" href={guideHref(rel)} data-reveal>
                <div class="guide-card__media">
                  <Image
                    src={rel.data.cover}
                    alt=""
                    widths={[400, 640, 1120]}
                    sizes="(min-width: 1216px) 560px, (min-width: 720px) 45vw, 100vw"
                    class="card-media"
                    loading="lazy"
                  />
                </div>
                <div class="guide-card__body">
                  <h3 class="guide-card__title">{rel.data.title}</h3>
                  <p class="guide-card__excerpt">{rel.data.excerpt}</p>
                  <span class="guide-card__meta">
                    {rel.data.readingMinutes} {t('guias.readingLabel')}
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
  {faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</Layout>

<script>
  // Las tablas de Markdown se envuelven para que desplacen en horizontal sin
  // romper el ancho de la columna de texto, con tabindex para poder recorrerlas
  // con teclado. Sin JS la propia tabla conserva el desplazamiento (ver estilos),
  // así que nunca hay desbordamiento horizontal de la página.
  document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
    if (table.parentElement?.classList.contains('gp-table-wrap')) return;
    const wrap = document.createElement('div');
    wrap.className = 'gp-table-wrap';
    wrap.tabIndex = 0;
    table.replaceWith(wrap);
    wrap.appendChild(table);
  });
</script>

<style>
  /* ---------- Cabecera editorial ---------- */
  .guide__head {
    background: var(--color-paper);
    padding-block: 8rem 2.5rem;
  }
  /* Alineada a la izquierda del contenedor, como el cuerpo del artículo. */
  .guide__head-inner {
    max-width: 52rem;
  }
  .guide__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-slate);
    text-decoration: none;
    transition: color 0.2s var(--ease-standard);
  }
  .guide__eyebrow:hover {
    color: var(--color-ink);
  }
  .guide__title {
    margin-top: 1.1rem;
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .guide__excerpt {
    margin-top: 1.25rem;
    max-width: 46rem;
  }
  .guide__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9rem;
    /* slate, no mist: mist (#7e8b81) se queda en 3,3:1 sobre papel — no llega a AA. */
    color: var(--color-slate);
  }
  .guide__dot {
    color: var(--color-mist);
  }

  /* ---------- Portada ---------- */
  /* Encuadre editorial fijo: las portadas verticales no pueden comerse una
     pantalla entera. La proporción se reserva por CSS desde el primer pintado,
     así que tampoco hay salto de maquetación (el <Image> ya trae width/height). */
  .guide__cover-frame {
    aspect-ratio: 4 / 3;
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--color-beige);
    box-shadow: 0 2px 4px -2px rgba(31, 55, 48, 0.18),
      0 28px 60px -34px rgba(31, 55, 48, 0.42);
  }
  .guide__cover-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Cuerpo + sumario ---------- */
  .guide__body {
    background: var(--color-paper);
    padding-block: clamp(2.5rem, 6vw, 4rem) var(--space-section);
  }
  /* minmax(0,…): sin esto una tabla ancha estira la pista y provoca scroll
     horizontal de página en móvil en vez de desplazarse dentro de su envoltorio. */
  .guide__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
  /* Tarjeta blanca con filete: sobre salvia el acento y el texto secundario se
     quedaban rozando el 4,5:1 del contraste AA. */
  .guide__toc {
    align-self: start;
    padding: 1.25rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
  }
  .guide__toc-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-slate);
    margin-bottom: 0.85rem;
  }
  .guide__toc-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }
  .guide__toc-list li {
    counter-increment: toc;
    display: flex;
    gap: 0.6rem;
    font-size: 0.925rem;
    line-height: 1.4;
  }
  .guide__toc-list li::before {
    content: counter(toc) '.';
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .guide__toc-list a {
    color: var(--color-graphite);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease-standard), color 0.2s var(--ease-standard);
  }
  .guide__toc-list a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent-solid);
  }

  /* ---------- Prosa del artículo ---------- */
  .prose {
    min-width: 0;
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-graphite);
  }
  .prose > :global(*:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin-top: 3.25rem;
    color: var(--color-ink);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 560;
    line-height: 1.18;
    letter-spacing: -0.018em;
    scroll-margin-top: 6rem;
  }
  .prose :global(h2)::before {
    content: '';
    display: block;
    width: 2.25rem;
    height: 2px;
    margin-bottom: 1.1rem;
    background: var(--color-accent-solid);
  }
  .prose :global(h3) {
    margin-top: 2.25rem;
    color: var(--color-ink);
    font-size: clamp(1.15rem, 1.9vw, 1.375rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
    scroll-margin-top: 6rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.15rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.55rem;
    padding-inline-start: 1.35rem;
  }
  .prose :global(li)::marker {
    color: var(--color-accent-solid);
  }
  .prose :global(li) > :global(ul),
  .prose :global(li) > :global(ol) {
    margin-top: 0.55rem;
  }
  .prose :global(strong) {
    color: var(--color-ink);
    font-weight: 640;
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 0.2s var(--ease-standard);
  }
  .prose :global(a):hover {
    color: var(--color-ink);
  }
  .prose :global(blockquote) {
    margin: 2.25rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-sagecard);
    border-inline-start: 3px solid var(--color-accent-solid);
    border-radius: 0 1rem 1rem 0;
    color: var(--color-graphite);
  }
  .prose :global(blockquote) > :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(hr) {
    margin: 2.75rem 0;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border-radius: 1rem;
  }
  .prose :global(code) {
    font-size: 0.925em;
    padding: 0.15em 0.4em;
    border-radius: 0.35rem;
    background: var(--color-beige);
  }

  /* Tablas: el envoltorio lo crea el script; sin JS la tabla desplaza sola. */
  .prose :global(.gp-table-wrap) {
    min-width: 0;
    max-width: 100%;
    margin-top: 1.75rem;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
  }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    margin-top: 1.75rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .prose :global(.gp-table-wrap) > :global(table) {
    display: table;
    width: 100%;
    min-width: 30rem;
    margin-top: 0;
    overflow: visible;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.8rem 1rem;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .prose :global(th) {
    background: var(--color-beige);
    color: var(--color-ink);
    font-weight: 620;
    white-space: nowrap;
  }
  .prose :global(tbody) > :global(tr:last-child) > :global(td) {
    border-bottom: 0;
  }

  /* ---------- FAQ (mismo lenguaje visual que Faq.astro) ---------- */
  .guide__faq {
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .guide__faq-wrap {
    max-width: 48rem;
  }
  .guide__faq-list {
    display: grid;
    gap: 0.5rem;
  }
  .guide__faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .guide__faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 0;
    font-size: 1.1rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .guide__faq-q::-webkit-details-marker {
    display: none;
  }
  .guide__faq-icon {
    flex: none;
    color: var(--color-slate);
    transition: transform 0.3s var(--ease-standard);
  }
  .guide__faq-item[open] .guide__faq-icon {
    transform: rotate(45deg);
  }
  .guide__faq-a {
    padding: 0 0 1.5rem;
    color: var(--color-slate);
    line-height: 1.6;
    max-width: 60ch;
  }

  /* ---------- CTA ---------- */
  .guide__cta {
    background: var(--color-deep);
    color: #fff;
  }
  .guide__cta-inner {
    max-width: 44rem;
  }
  .guide__cta-text {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.74);
  }
  .guide__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }
  .guide__cta-money {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color 0.2s var(--ease-standard);
  }
  .guide__cta-money:hover {
    color: #fff;
  }

  /* ---------- Guías relacionadas ---------- */
  .guide__related {
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
  }
  .guide__related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .guide__related-head :global(.sec-head) {
    margin-bottom: 0;
  }
  .guide__related-cta {
    flex: none;
  }
  .guide__related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .guide-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .guide-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .guide-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .guide-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.3rem 1.4rem 1.5rem;
  }
  .guide-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.28;
