---
/**
 * Layout base. Cabeza SEO completa (title/description/canonical/hreflang/OG),
 * preload de la fuente, JSON-LD global del negocio, Header + main + Footer +
 * botón flotante de WhatsApp y el runtime de animaciones. Todo el contenido se
 * sirve en el HTML (SSG) — el SEO no depende de JS de cliente (§2, §8).
 */
import '../styles/global.css';
import ConsentGtm from '../components/ConsentGtm.astro';
import BrandLoader from '../components/BrandLoader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLocaleFromUrl, localeHtmlLang, localeOgLocale, useTranslations } from '../i18n/ui';
import { alternatesFor, type RouteKey } from '../i18n/routes';
import { site } from '../config/site';
import { OG_ROUTE_IDS, ogImagePath } from '../lib/og-meta';
import logo from '../assets/brand/reforma-bcn-logo.png';

interface Props {
  title?: string;
  description?: string;
  routeKey?: RouteKey;
  overHero?: boolean;
  image?: string;
  noindex?: boolean;
  /** No añadir el sufijo de marca al <title> (títulos fijados por especificación). */
  exactTitle?: boolean;
  /** Intro de marca a pantalla completa (solo la home). Ver Preloader.astro. */
  preloader?: boolean;
  /** Alternates hreflang explícitos (p. ej. detalle de proyecto con slug propio). */
  alternates?: { locale: import('../i18n/ui').Locale; path: string }[];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const {
  title = t('meta.defaultTitle'),
  description = t('meta.defaultDescription'),
  routeKey,
  overHero = false,
  image,
  noindex = false,
  exactTitle = false,
  preloader = false,
  alternates: alternatesProp,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.reformabcn.es');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
// OG por página (Fase 8): imagen explícita (p. ej. detalle de proyecto) o la
// generada para su routeKey/idioma; sin routeKey conocido → 'default'.
const ogId = routeKey && (OG_ROUTE_IDS as readonly string[]).includes(routeKey) ? routeKey : 'default';
const ogImage = new URL(image ?? ogImagePath(ogId, locale), siteUrl).href;
const fullTitle = exactTitle || title.includes(site.name) ? title : `${title} · ${site.name}`;

// hreflang: alternates explícitos > por routeKey > ninguno.
const alternates = alternatesProp ?? (routeKey ? alternatesFor(routeKey) : []);

// JSON-LD global del negocio (§8). Se omite todo campo [PENDIENTE] para no
// emitir datos estructurados con texto de relleno; se completa al recibir los
// datos reales de la empresa. Entidades enlazadas por @id (negocio + web).
const clean = (v?: string): string | undefined =>
  v && !v.includes('[PENDIENTE') ? v : undefined;

const logoUrl = new URL(logo.src, siteUrl).href;
const businessId = `${siteUrl.href}#business`;
const websiteId = `${siteUrl.href}#website`;
const socialLinks = Object.values(site.social).filter(Boolean);

const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': businessId,
  name: site.name,
  legalName: clean(site.legalName),
  description: t('meta.defaultDescription'),
  url: siteUrl.href,
  telephone: clean(site.phone),
  email: site.email,
  image: logoUrl,
  logo: logoUrl,
  priceRange: '€€€',
  areaServed: site.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  address: {
    '@type': 'PostalAddress',
    streetAddress: clean(site.address.street),
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: clean(site.address.postalCode),
    addressCountry: site.address.country,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '19:00',
  },
  // Sólo se publica geo cuando hay coordenadas reales (no un punto inventado).
  ...(site.geo ? { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } } : {}),
  ...(socialLinks.length ? { sameAs: socialLinks } : {}),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: site.name,
  url: siteUrl.href,
  inLanguage: localeHtmlLang[locale],
  publisher: { '@id': businessId },
};
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Consent Mode v2 + GTM (Fase 7). Lo primero: fija los defaults DENEGADOS
         antes de que cualquier etiqueta pueda leer el estado de consentimiento. -->
    <ConsentGtm />

    <!-- Marca JS activo lo antes posible: el estado oculto de las animaciones
         sólo se aplica con html.js (sin JS todo es visible). Evita FOUC. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f5f0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang (x-default → es) -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={new URL(alt.path, siteUrl).href} />
    ))}
    {alternates.length > 0 && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(alternates.find((a) => a.locale === 'es')!.path, siteUrl).href}
      />
    )}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeOgLocale[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fuente: preload del woff2 (subset latin) + swap -->
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body>
    {preloader && <BrandLoader />}
    <Header locale={locale} routeKey={routeKey} overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFab locale={locale} />
    <CookieConsent locale={locale} />

    <script>
      import '../scripts/site.ts';
      import '../scripts/forms.ts';
      import '../scripts/consent.ts';
      import '../scripts/tracking.ts';
    </script>
  </body>
</html>
