---
/**
 * Layout base. Cabeza SEO completa (title/description/canonical/hreflang/OG),
 * preload de la fuente, JSON-LD global del negocio, Header + main + Footer +
 * botón flotante de WhatsApp y el runtime de animaciones. Todo el contenido se
 * sirve en el HTML (SSG) — el SEO no depende de JS de cliente (§2, §8).
 */
import '../styles/global.css';
import ConsentGtm from '../components/ConsentGtm.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getLocaleFromUrl, localeHtmlLang, useTranslations } from '../i18n/ui';
import { alternatesFor, type RouteKey } from '../i18n/routes';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  routeKey?: RouteKey;
  overHero?: boolean;
  image?: string;
  noindex?: boolean;
  /** Alternates hreflang explícitos (p. ej. detalle de proyecto con slug propio). */
  alternates?: { locale: import('../i18n/ui').Locale; path: string }[];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const {
  title = t('meta.defaultTitle'),
  description = t('meta.defaultDescription'),
  routeKey,
  overHero = false,
  image = '/og/default.jpg',
  noindex = false,
  alternates: alternatesProp,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.bastinou.com');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

// hreflang: alternates explícitos > por routeKey > ninguno.
const alternates = alternatesProp ?? (routeKey ? alternatesFor(routeKey) : []);

// JSON-LD global del negocio (§8) — se ampliará en Fase 8.
const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  description,
  url: siteUrl.href,
  telephone: site.phone,
  email: site.email,
  areaServed: site.areaServed,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
};
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Consent Mode v2 + GTM (Fase 7). Lo primero: fija los defaults DENEGADOS
         antes de que cualquier etiqueta pueda leer el estado de consentimiento. -->
    <ConsentGtm />

    <!-- Marca JS activo lo antes posible: el estado oculto de las animaciones
         sólo se aplica con html.js (sin JS todo es visible). Evita FOUC. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang (x-default → es) -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={new URL(alt.path, siteUrl).href} />
    ))}
    {alternates.length > 0 && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(alternates.find((a) => a.locale === 'es')!.path, siteUrl).href}
      />
    )}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeHtmlLang[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fuente: preload del woff2 (subset latin) + swap -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessLd)} />
  </head>
  <body>
    <Header locale={locale} routeKey={routeKey} overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFab locale={locale} />
    <CookieConsent locale={locale} />

    <script>
      import '../scripts/site.ts';
      import '../scripts/forms.ts';
      import '../scripts/consent.ts';
      import '../scripts/tracking.ts';
    </script>
  </body>
</html>
